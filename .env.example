# ProofPath Environment Configuration
DEMO_MODE=true

# Database Configuration:
# For local SQLite development (default if DATABASE_URL is unset):
# DATABASE_URL=sqlite:///../../data/proofpath.db
# For production PostgreSQL (Supabase / Neon / RDS / Cloud SQL):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Security / JWT Configuration:
SECRET_KEY=change-this-in-development-super-secret-key-proofpath
JWT_SECRET=change-this-in-development-super-secret-key-proofpath
JWT_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated or JSON array):
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,http://127.0.0.1:3000,http://127.0.0.1:8081
